# Copy to .env and fill in real values. Never commit the resulting .env file.

# ── LLM credentials ────────────────────────────────────────────────────────────
# The app talks to any OpenAI-compatible chat completions endpoint.
#
# Option 1: OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
#
# Option 2: Groq (OpenAI-compatible API, much faster/cheaper for dev+testing)
OPENAI_API_KEY=gsk_your-groq-key-here
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# REST API auth — required, no insecure default is provided by the app
API_KEY=change-me-to-a-long-random-secret

# MCP server auth — required, no insecure default is provided by the app
MCP_API_KEY=change-me-to-a-long-random-secret
MCP_PORT=8001

# Optional: legacy env var names supported for backward compatibility
# endpoint=
# deployment_name=

# Optional: how long (seconds) finished thread/incident records are kept in memory
THREAD_TTL_SECONDS=86400
INCIDENT_TTL_SECONDS=86400
